<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration PUBLIC "-//mybatis.org//DTD Config 3.0//EN" "http://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
    <settings>
        <setting name="mapUnderscoreToCamelCase" value="true"/>
        <setting name="jdbcTypeForNull" value="NULL"/>
        <setting name="callSettersOnNulls" value="true"/>
    </settings>
    <typeAliases>
        <typeAlias alias="lowerCamelCaseMap" type="com.lguplus.wafful.framework.model.map.LowerCamelCaseMap"/>
        <typeAlias alias="dataHashMap" type="com.lguplus.wafful.framework.model.map.DataHashMap"/>
    </typeAliases>
    <plugins>
        <plugin interceptor="com.lguplus.wafful.framework.compensation.interceptor.MybatisSqlInterceptor"/>
    </plugins>
</configuration>
